{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["types.d.ts", "app.js", "explorer.js", "model-spec.js", "diagram-projection.js", "examples.js", "cli.mjs", "core/*.js", "core/*.mjs", "tests/*.mjs"],
  "exclude": ["node_modules", "vendor"]
}
