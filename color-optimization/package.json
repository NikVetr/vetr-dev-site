{
  "name": "color-optimization",
  "version": "1.0.0",
  "description": "Color palette optimization tool",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "node node_modules/@playwright/test/cli.js test tests/regressions.spec.js",
    "screenshot": "npx playwright test tests/screenshot.spec.js",
    "serve": "npx http-server . -p 8080 -c-1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "http-server": "^14.1.1"
  }
}
